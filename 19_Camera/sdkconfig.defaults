# YD-ESP32-S3 V1.4: 8 MB SPI Flash + 8 MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP-DL COCO Detect: keep only the 320x320 INT8 YOLO11n model.
CONFIG_FLASH_COCO_DETECT_YOLO11N_S8_V1=n
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_MODEL_IN_FLASH_PARTITION=y

# Use an 8 MB-compatible custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

# YOLO11n inference occupies CPU1 for several seconds on ESP32-S3.
# Keep the CPU0 camera/LCD task responsive and do not treat CPU1 idle starvation
# as a watchdog fault while the dedicated inference task is running.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
