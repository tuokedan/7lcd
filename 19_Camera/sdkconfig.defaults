# YD-ESP32-S3 V1.4: 8 MB SPI Flash + 8 MB Octal PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP-DL COCO Detect: 320x320 INT8 YOLO11n model
CONFIG_FLASH_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_YOLO11N_320_S8_V1=y
CONFIG_COCO_DETECT_MODEL_IN_FLASH_PARTITION=y

# Use an 8 MB-compatible custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"
